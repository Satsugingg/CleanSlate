<Window x:Class="CleanSlate.Uninstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CleanSlate Uninstaller"
        Width="460"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#141414"
        Foreground="#F2FFFFFF"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        Loaded="OnWindowLoaded">

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBgBrush" Color="#121214" />
        <SolidColorBrush x:Key="CardBgBrush" Color="#1A1A1E" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#2A2A30" />
        <SolidColorBrush x:Key="DangerBrush" Color="#EF5350" />
        <SolidColorBrush x:Key="DangerHoverBrush" Color="#E57373" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A0A0AA" />

        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,6" />
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#EF5350" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E57373" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- App Banner -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <Border Width="52" Height="52" CornerRadius="12" Background="#25EF5350" BorderBrush="#50EF5350" BorderThickness="1.5" Margin="0,0,16,0">
                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="#EF5350" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Uninstall CleanSlate" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" />
                <TextBlock Text="Remove CleanSlate desktop dock from this PC." FontSize="12.5" Foreground="#A0A0AA" Margin="0,3,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- Options Card -->
        <Border Grid.Row="1" x:Name="OptionsCard" Background="#1A1A1E" BorderBrush="#2A2A30" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,16">
            <StackPanel>
                <!-- Target Location Display -->
                <StackPanel>
                    <TextBlock Text="UNINSTALLING FROM" FontSize="10.5" FontWeight="Bold" Foreground="#8A8A96" Margin="1,0,0,5" />
                    <Border Background="#121215" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#EF5350" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Grid.Column="1" x:Name="TargetLocationText"
                                       Text="C:\Users\...\AppData\Local\CleanSlate\app"
                                       FontSize="11.5"
                                       Foreground="#E0E0E8"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Progress / Status Area & Actions -->
        <StackPanel Grid.Row="2">
            <TextBlock x:Name="StatusText" Text="Ready to uninstall CleanSlate." FontSize="12" Foreground="#A0A0AA" TextWrapping="Wrap" Margin="2,0,2,8" />
            <ProgressBar x:Name="UninstallProgressBar" Height="4" Maximum="100" Value="0" Foreground="#EF5350" Background="#222228" BorderThickness="0" Visibility="Collapsed" Margin="0,0,0,14" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="VersionText" Grid.Column="0" Text="v1.0.0" FontSize="11.5" Foreground="#66666E" VerticalAlignment="Center" />

                <Button x:Name="CancelButton"
                        Grid.Column="1"
                        Content="Cancel"
                        Background="Transparent"
                        Foreground="#A0A0AA"
                        FontSize="13"
                        Padding="14,8"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="0,0,8,0"
                        Click="OnCancelClick" />

                <Button x:Name="ActionButton"
                        Grid.Column="2"
                        Content="Uninstall"
                        Style="{StaticResource DangerButtonStyle}"
                        Click="OnActionButtonClick" />
            </Grid>
        </StackPanel>
    </Grid>
</Window>
