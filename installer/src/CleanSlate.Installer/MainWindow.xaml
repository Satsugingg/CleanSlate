<Window x:Class="CleanSlate.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CleanSlate Setup"
        Width="460"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#141414"
        Foreground="#F2FFFFFF"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        Loaded="OnWindowLoaded">

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBgBrush" Color="#121214" />
        <SolidColorBrush x:Key="CardBgBrush" Color="#1A1A1E" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#2A2A30" />
        <SolidColorBrush x:Key="AccentBrush" Color="#64B5F6" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#90CAF9" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A0A0AA" />

        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,6" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF64B5F6" />
            <Setter Property="Foreground" Value="#0A0A0C" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF90CAF9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- App Banner -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <Border Width="52" Height="52" CornerRadius="12" Background="#1E64B5F6" BorderBrush="#4064B5F6" BorderThickness="1.5" Margin="0,0,16,0">
                <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="#FF64B5F6" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="HeroTitleText" Text="CleanSlate Setup" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" />
                <TextBlock x:Name="HeroSubtitleText" Text="The sleek, modern desktop dock for Windows." FontSize="12.5" Foreground="#A0A0AA" Margin="0,3,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- Options Card -->
        <Border Grid.Row="1" x:Name="OptionsCard" Background="#1A1A1E" BorderBrush="#2A2A30" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,16">
            <StackPanel>
                <!-- Install Location Configuration -->
                <StackPanel x:Name="InstallLocationPanel" Margin="0,0,0,14">
                    <TextBlock Text="INSTALL LOCATION" FontSize="10.5" FontWeight="Bold" Foreground="#8A8A96" Margin="1,0,0,5" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#121215" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,8,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#64B5F6" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Grid.Column="1" x:Name="InstallLocationTextBox"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="#FFFFFF"
                                         CaretBrush="#64B5F6"
                                         FontSize="12"
                                         VerticalAlignment="Center"
                                         Text="C:\Users\..." />
                            </Grid>
                        </Border>
                        <Button Grid.Column="1" x:Name="BrowseButton"
                                Content="Browse..."
                                Click="OnBrowseLocationClick"
                                Background="#222228"
                                Foreground="#E0E0E8"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Padding="12,6"
                                BorderBrush="#33333E"
                                BorderThickness="1"
                                Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6" />
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- Install Mode Options -->
                <StackPanel x:Name="InstallOptionsPanel">
                    <CheckBox x:Name="StartupCheckBox" Style="{StaticResource ModernCheckBox}" IsChecked="True" Content="Start CleanSlate automatically at Windows logon" />
                    <CheckBox x:Name="ShortcutsCheckBox" Style="{StaticResource ModernCheckBox}" IsChecked="True" Content="Create Start Menu shortcuts" />
                    <CheckBox x:Name="LaunchCheckBox" Style="{StaticResource ModernCheckBox}" IsChecked="True" Content="Launch CleanSlate when installation finishes" />
                </StackPanel>

                <!-- Uninstall Mode Options -->
                <StackPanel x:Name="UninstallOptionsPanel" Visibility="Collapsed">
                    <TextBlock Text="CleanSlate application files and shortcuts will be removed. Your personal desktop shortcuts will remain untouched."
                               Foreground="#A0A0AA" FontSize="12.5" TextWrapping="Wrap" LineHeight="18" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Progress / Status Area & Actions -->
        <StackPanel Grid.Row="2">
            <TextBlock x:Name="StatusText" Text="Ready to install CleanSlate." FontSize="12" Foreground="#A0A0AA" TextWrapping="Wrap" Margin="2,0,2,8" />
            <ProgressBar x:Name="InstallProgressBar" Height="4" Maximum="100" Value="0" Foreground="#64B5F6" Background="#222228" BorderThickness="0" Visibility="Collapsed" Margin="0,0,0,14" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="VersionText" Grid.Column="0" Text="v1.0.0" FontSize="11.5" Foreground="#66666E" VerticalAlignment="Center" />

                <Button x:Name="CancelButton"
                        Grid.Column="1"
                        Content="Cancel"
                        Background="Transparent"
                        Foreground="#A0A0AA"
                        FontSize="13"
                        Padding="14,8"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="0,0,8,0"
                        Click="OnCancelClick" />

                <Button x:Name="ActionButton"
                        Grid.Column="2"
                        Content="Install"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="OnActionButtonClick" />
            </Grid>
        </StackPanel>
    </Grid>
</Window>
