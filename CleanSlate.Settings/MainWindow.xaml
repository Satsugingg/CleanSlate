<Window x:Class="CleanSlate.Settings.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CleanSlate Settings"
        Icon="Assets/CleanSlate.ico"
        Width="468"
        MaxHeight="680"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#141416"
        Foreground="#F2FFFFFF"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        Deactivated="OnWindowDeactivated">

    <Window.Resources>
        <!-- Windows 11 Style Toggle Switch -->
        <Style x:Key="FluentToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track"
                                Width="40"
                                Height="22"
                                CornerRadius="11"
                                Background="#26FFFFFF"
                                BorderBrush="#38FFFFFF"
                                BorderThickness="1">
                            <Ellipse x:Name="Thumb"
                                     Width="14"
                                     Height="14"
                                     Margin="3,0"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Fill="#D8FFFFFF" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#36FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#FF64B5F6" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="#FF64B5F6" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Fill" Value="#FF111111" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Track" Property="Background" Value="#FF80C4F8" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="#FF80C4F8" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Action Button -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1AFFFFFF" />
            <Setter Property="BorderBrush" Value="#28FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#F0FFFFFF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2AFFFFFF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#40FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Grouped Section Card Container -->
        <Style x:Key="GroupCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#1A1A1E" />
            <Setter Property="BorderBrush" Value="#16FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <!-- Setting Row Container -->
        <Style x:Key="SettingRowStyle" TargetType="Border">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Subtle Row Divider -->
        <Style x:Key="RowDividerStyle" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="#0DFFFFFF" />
            <Setter Property="Margin" Value="14,0" />
        </Style>

        <!-- Section Category Header -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#78C8FF" />
            <Setter Property="Margin" Value="2,0,0,6" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  BorderThickness="0">
        <StackPanel Margin="18,16,18,18">
            <!-- Header -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="Assets/CleanSlate.ico"
                               Width="22"
                               Height="22"
                               Margin="0,0,10,0"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               VerticalAlignment="Center" />
                        <TextBlock Text="CleanSlate"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFFFFFF" />
                        <Border Margin="10,0,0,0"
                                Padding="6,2"
                                CornerRadius="4"
                                Background="#2064B5F6"
                                BorderBrush="#4064B5F6"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <TextBlock Text="SETTINGS"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="#78C8FF" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Changes save automatically and apply immediately on summon."
                               FontSize="11.5"
                               Foreground="#80FFFFFF"
                               Margin="0,3,0,0" />
                </StackPanel>
            </Grid>

            <!-- ========================================================= -->
            <!-- 1. APPEARANCE & ICONS                                      -->
            <!-- ========================================================= -->
            <TextBlock Text="Appearance &amp; Icons" Style="{StaticResource SectionHeaderStyle}" />

            <Border Style="{StaticResource GroupCardStyle}">
                <StackPanel>
                    <!-- Icon Size Slider -->
                    <Border Style="{StaticResource SettingRowStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Icon Size"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Foreground="#F0FFFFFF" />
                                    <TextBlock Text="Adjust shortcut icon dimensions in Dock and Mini Desktop modes."
                                               FontSize="11.5"
                                               Foreground="#7AFFFFFF"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <TextBlock x:Name="IconSizeValueText"
                                           Grid.Column="1"
                                           Text="48 px"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="#78C8FF"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <Slider x:Name="IconSizeSlider"
                                    Grid.Row="1"
                                    Margin="0,9,0,2"
                                    Minimum="24"
                                    Maximum="96"
                                    TickFrequency="4"
                                    IsSnapToTickEnabled="True"
                                    Value="48"
                                    ValueChanged="OnIconSizeSliderValueChanged" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource RowDividerStyle}" />

                    <!-- Show Icon Labels -->
                    <Border Style="{StaticResource SettingRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Show Icon Labels"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           Foreground="#F0FFFFFF" />
                                <TextBlock Text="Display shortcut names underneath each icon."
                                           FontSize="11.5"
                                           Foreground="#7AFFFFFF"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <CheckBox x:Name="ShowLabelsToggle"
                                      Grid.Column="1"
                                      Style="{StaticResource FluentToggleSwitchStyle}"
                                      Checked="OnSettingToggled"
                                      Unchecked="OnSettingToggled" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource RowDividerStyle}" />

                    <!-- Settings Button in Dock -->
                    <Border Style="{StaticResource SettingRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Settings Button in Dock"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           Foreground="#F0FFFFFF" />
                                <TextBlock Text="Display a dedicated CleanSlate icon directly inside the app dock."
                                           FontSize="11.5"
                                           Foreground="#7AFFFFFF"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <CheckBox x:Name="ShowSettingsButtonToggle"
                                      Grid.Column="1"
                                      Style="{StaticResource FluentToggleSwitchStyle}"
                                      Checked="OnSettingToggled"
                                      Unchecked="OnSettingToggled" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource RowDividerStyle}" />

                    <!-- Corner Recycle Bin -->
                    <Border Style="{StaticResource SettingRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Show Corner Recycle Bin"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           Foreground="#F0FFFFFF" />
                                <TextBlock Text="Display a discreet Recycle Bin shortcut in the bottom-right corner."
                                           FontSize="11.5"
                                           Foreground="#7AFFFFFF"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <CheckBox x:Name="ShowCornerRecycleBinToggle"
                                      Grid.Column="1"
                                      Style="{StaticResource FluentToggleSwitchStyle}"
                                      Checked="OnSettingToggled"
                                      Unchecked="OnSettingToggled" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ========================================================= -->
            <!-- 2. DOCK LAYOUT & GRID                                      -->
            <!-- ========================================================= -->
            <TextBlock Text="Dock Layout &amp; Grid" Style="{StaticResource SectionHeaderStyle}" />

            <Border Style="{StaticResource GroupCardStyle}">
                <StackPanel>
                    <!-- Mini Desktop Mode -->
                    <Border Style="{StaticResource SettingRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Mini Desktop Mode"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           Foreground="#F0FFFFFF" />
                                <TextBlock Text="Expand to a 1/4-screen mini desktop with freely arrangeable grid icons."
                                           FontSize="11.5"
                                           Foreground="#7AFFFFFF"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <CheckBox x:Name="MiniDesktopToggle"
                                      Grid.Column="1"
                                      Style="{StaticResource FluentToggleSwitchStyle}"
                                      Checked="OnSettingToggled"
                                      Unchecked="OnSettingToggled" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource RowDividerStyle}" />

                    <!-- Dock & Grid Dimensions -->
                    <Border x:Name="DockSizeCard" Style="{StaticResource SettingRowStyle}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Dock &amp; Grid Dimensions"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Foreground="#F0FFFFFF" />
                                    <TextBlock Text="Presets or custom grid columns × rows and pixel bounds."
                                               FontSize="11.5"
                                               Foreground="#7AFFFFFF"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="DockSizeSmallButton"
                                            Padding="9,5"
                                            Content="Small"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Click="OnDockSizePresetClick"
                                            Tag="440,320" />
                                    <Button x:Name="DockSizeDefaultButton"
                                            Margin="5,0,0,0"
                                            Padding="9,5"
                                            Content="Default"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Click="OnDockSizePresetClick"
                                            Tag="520,360" />
                                    <Button x:Name="DockSizeLargeButton"
                                            Margin="5,0,0,0"
                                            Padding="9,5"
                                            Content="Large"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Click="OnDockSizePresetClick"
                                            Tag="680,440" />
                                </StackPanel>
                            </Grid>

                            <!-- Custom cols/rows and width/height inputs -->
                            <Border Margin="0,10,0,2"
                                    Padding="10,8"
                                    Background="#14FFFFFF"
                                    CornerRadius="7"
                                    BorderBrush="#18FFFFFF"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Columns x Rows input -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Grid:"
                                                   FontSize="11.5"
                                                   Foreground="#A0FFFFFF"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,5,0" />
                                        <TextBox x:Name="CustomColsTextBox"
                                                 Width="32"
                                                 Height="25"
                                                 VerticalContentAlignment="Center"
                                                 HorizontalContentAlignment="Center"
                                                 FontSize="12"
                                                 Foreground="#FFFFFF"
                                                 Background="#24262C"
                                                 BorderBrush="#38FFFFFF"
                                                 BorderThickness="1"
                                                 TextChanged="OnCustomColsRowsTextChanged"
                                                 PreviewKeyDown="OnCustomInputPreviewKeyDown"
                                                 LostFocus="OnCustomInputLostFocus" />
                                        <TextBlock Text="×"
                                                   FontSize="11.5"
                                                   Foreground="#88FFFFFF"
                                                   VerticalAlignment="Center"
                                                   Margin="4,0,4,0" />
                                        <TextBox x:Name="CustomRowsTextBox"
                                                 Width="32"
                                                 Height="25"
                                                 VerticalContentAlignment="Center"
                                                 HorizontalContentAlignment="Center"
                                                 FontSize="12"
                                                 Foreground="#FFFFFF"
                                                 Background="#24262C"
                                                 BorderBrush="#38FFFFFF"
                                                 BorderThickness="1"
                                                 TextChanged="OnCustomColsRowsTextChanged"
                                                 PreviewKeyDown="OnCustomInputPreviewKeyDown"
                                                 LostFocus="OnCustomInputLostFocus" />
                                        <TextBlock Text="cells"
                                                   FontSize="11"
                                                   Foreground="#88FFFFFF"
                                                   VerticalAlignment="Center"
                                                   Margin="4,0,14,0" />
                                    </StackPanel>

                                    <!-- Width x Height px input -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Size:"
                                                   FontSize="11.5"
                                                   Foreground="#A0FFFFFF"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,5,0" />
                                        <TextBox x:Name="CustomWidthTextBox"
                                                 Width="42"
                                                 Height="25"
                                                 VerticalContentAlignment="Center"
                                                 HorizontalContentAlignment="Center"
                                                 FontSize="12"
                                                 Foreground="#FFFFFF"
                                                 Background="#24262C"
                                                 BorderBrush="#38FFFFFF"
                                                 BorderThickness="1"
                                                 TextChanged="OnCustomWidthHeightTextChanged"
                                                 PreviewKeyDown="OnCustomInputPreviewKeyDown"
                                                 LostFocus="OnCustomInputLostFocus" />
                                        <TextBlock Text="×"
                                                   FontSize="11.5"
                                                   Foreground="#88FFFFFF"
                                                   VerticalAlignment="Center"
                                                   Margin="4,0,4,0" />
                                        <TextBox x:Name="CustomHeightTextBox"
                                                 Width="42"
                                                 Height="25"
                                                 VerticalContentAlignment="Center"
                                                 HorizontalContentAlignment="Center"
                                                 FontSize="12"
                                                 Foreground="#FFFFFF"
                                                 Background="#24262C"
                                                 BorderBrush="#38FFFFFF"
                                                 BorderThickness="1"
                                                 TextChanged="OnCustomWidthHeightTextChanged"
                                                 PreviewKeyDown="OnCustomInputPreviewKeyDown"
                                                 LostFocus="OnCustomInputLostFocus" />
                                        <TextBlock Text="px"
                                                   FontSize="11"
                                                   Foreground="#88FFFFFF"
                                                   VerticalAlignment="Center"
                                                   Margin="4,0,8,0" />
                                    </StackPanel>

                                    <!-- Apply Button -->
                                    <Button x:Name="ApplyCustomSizeButton"
                                            Grid.Column="2"
                                            Content="Apply"
                                            Padding="10,4"
                                            FontSize="11.5"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Click="OnApplyCustomSizeClick" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ========================================================= -->
            <!-- 3. SHORTCUTS & SEARCH                                      -->
            <!-- ========================================================= -->
            <TextBlock Text="Shortcuts &amp; Search" Style="{StaticResource SectionHeaderStyle}" />

            <Border Style="{StaticResource GroupCardStyle}">
                <StackPanel>
                    <!-- Global Summon Hotkey -->
                    <Border Style="{StaticResource SettingRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Global Summon Hotkey"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           Foreground="#F0FFFFFF" />
                                <TextBlock Text="Press anywhere to toggle CleanSlate over open windows."
                                           FontSize="11.5"
                                           Foreground="#7AFFFFFF"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="SummonShortcutButton"
                                        MinWidth="104"
                                        Content="Ctrl+Alt+Space"
                                        FontWeight="SemiBold"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Click="OnSummonShortcutButtonClick" />
                                <Button x:Name="ClearSummonShortcutButton"
                                        Margin="5,0,0,0"
                                        Padding="8,5"
                                        Content="Off"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Click="OnClearSummonShortcutClick" />
                                <Button x:Name="ResetSummonShortcutButton"
                                        Margin="5,0,0,0"
                                        Padding="8,5"
                                        Content="Reset"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Click="OnResetSummonShortcutClick" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource RowDividerStyle}" />

                    <!-- Enable Search Bar -->
                    <Border Style="{StaticResource SettingRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Enable Search Bar"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           Foreground="#F0FFFFFF" />
                                <TextBlock Text="Allow opening the inline search bar to filter and launch shortcuts."
                                           FontSize="11.5"
                                           Foreground="#7AFFFFFF"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <CheckBox x:Name="EnableSearchToggle"
                                      Grid.Column="1"
                                      Style="{StaticResource FluentToggleSwitchStyle}"
                                      Checked="OnSettingToggled"
                                      Unchecked="OnSettingToggled" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource RowDividerStyle}" />

                    <!-- Search Keybind inside Dock -->
                    <Border x:Name="SearchKeybindCard" Style="{StaticResource SettingRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Search Keybind"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           Foreground="#F0FFFFFF" />
                                <TextBlock Text="Key pressed inside the dock to open search (default: /)."
                                           FontSize="11.5"
                                           Foreground="#7AFFFFFF"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="SearchShortcutButton"
                                        MinWidth="72"
                                        Content="/"
                                        FontWeight="SemiBold"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Click="OnSearchShortcutButtonClick" />
                                <Button x:Name="ResetSearchShortcutButton"
                                        Margin="5,0,0,0"
                                        Padding="8,5"
                                        Content="Reset"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Click="OnResetSearchShortcutClick" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ========================================================= -->
            <!-- 4. SYSTEM & MAINTENANCE                                    -->
            <!-- ========================================================= -->
            <TextBlock Text="System &amp; Maintenance" Style="{StaticResource SectionHeaderStyle}" />

            <Border Style="{StaticResource GroupCardStyle}" Margin="0,0,0,4">
                <StackPanel>
                    <!-- Launch on Startup -->
                    <Border Style="{StaticResource SettingRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Launch on Windows Startup"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           Foreground="#F0FFFFFF" />
                                <TextBlock Text="Start CleanSlate automatically when you sign in to Windows."
                                           FontSize="11.5"
                                           Foreground="#7AFFFFFF"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <CheckBox x:Name="LaunchOnStartupToggle"
                                      Grid.Column="1"
                                      Style="{StaticResource FluentToggleSwitchStyle}"
                                      Checked="OnStartupToggled"
                                      Unchecked="OnStartupToggled" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource RowDividerStyle}" />

                    <!-- Transfer Desktop to Dock -->
                    <Border Style="{StaticResource SettingRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Transfer Desktop to Dock"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           Foreground="#F0FFFFFF" />
                                <TextBlock x:Name="TransferStatusText"
                                           Text="Transfer all desktop shortcuts and files back into the CleanSlate dock."
                                           FontSize="11.5"
                                           Foreground="#7AFFFFFF"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <Button x:Name="TransferIconsButton"
                                    Grid.Column="1"
                                    Content="Transfer All"
                                    Style="{StaticResource ActionButtonStyle}"
                                    VerticalAlignment="Center"
                                    Click="OnTransferDesktopToDockClick" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource RowDividerStyle}" />

                    <!-- Reset Desktop Icons -->
                    <Border Style="{StaticResource SettingRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Restore Desktop Shortcuts"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           Foreground="#F0FFFFFF" />
                                <TextBlock x:Name="RestoreStatusText"
                                           Text="Restore all managed app shortcuts and the Recycle Bin back onto your Windows desktop."
                                           FontSize="11.5"
                                           Foreground="#7AFFFFFF"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <Button x:Name="RestoreIconsButton"
                                    Grid.Column="1"
                                    Content="Restore All"
                                    Style="{StaticResource ActionButtonStyle}"
                                    VerticalAlignment="Center"
                                    Click="OnResetDesktopIconsClick" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource RowDividerStyle}" />

                    <!-- Check for Updates -->
                    <Border Style="{StaticResource SettingRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Software Updates"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           Foreground="#F0FFFFFF" />
                                <TextBlock x:Name="UpdateStatusText"
                                           Text="Installed version: v1.1.0"
                                           FontSize="11.5"
                                           Foreground="#7AFFFFFF"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Button x:Name="InstallUpdateButton"
                                        Content="Install Update"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Visibility="Collapsed"
                                        Margin="0,0,8,0"
                                        Click="OnInstallUpdateClick" />
                                <Button x:Name="CheckUpdatesButton"
                                        Content="Check for Updates"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Click="OnCheckForUpdatesClick" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
