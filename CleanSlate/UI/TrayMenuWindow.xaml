<Window x:Class="CleanSlate.UI.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Deactivated="OnWindowDeactivated"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <Window.Resources>
        <Style x:Key="TrayMenuItemButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#F0FFFFFF" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2EFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="10"
            MinWidth="214"
            Background="#EE1A1A1A"
            BorderBrush="#2EFFFFFF"
            BorderThickness="1"
            CornerRadius="10"
            Padding="5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.55" Color="#000000" />
        </Border.Effect>

        <StackPanel>
            <Button Style="{StaticResource TrayMenuItemButtonStyle}" Click="OnOpenCleanSlateClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8A9;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#78C8FF" />
                    <TextBlock Text="Open CleanSlate" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Style="{StaticResource TrayMenuItemButtonStyle}" Click="OnOpenRecycleBinClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#C8FFFFFF" />
                    <TextBlock Text="Open Recycle Bin" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Style="{StaticResource TrayMenuItemButtonStyle}" Click="OnOpenShortcutsFolderClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#C8FFFFFF" />
                    <TextBlock Text="Open Shortcuts Folder" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Style="{StaticResource TrayMenuItemButtonStyle}" Click="OnOpenSettingsClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#C8FFFFFF" />
                    <TextBlock Text="Settings..." VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Style="{StaticResource TrayMenuItemButtonStyle}" Click="OnToggleStartupClick">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StartupCheckGlyph"
                               Text="&#xE73E;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               Foreground="#78C8FF" />
                    <TextBlock Grid.Column="1" Text="Toggle Windows Startup" VerticalAlignment="Center" />
                </Grid>
            </Button>

            <Border Height="1" Background="#1FFFFFFF" Margin="6,4" />

            <Button Style="{StaticResource TrayMenuItemButtonStyle}" Click="OnExitClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#FF7A7A" />
                    <TextBlock Text="Exit" Foreground="#FFE8E8" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</Window>
