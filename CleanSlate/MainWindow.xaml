<Window x:Class="CleanSlate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
        xmlns:conv="clr-namespace:CleanSlate.UI.Converters"
        Title="CleanSlate"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        ShowInTaskbar="False"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Focusable="True"
        FocusVisualStyle="{x:Null}"
        AllowDrop="True"
        Deactivated="OnWindowDeactivated"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        PreviewTextInput="OnWindowPreviewTextInput"
        DragOver="OnWindowDragOver"
        Drop="OnWindowDrop"
        Closing="OnWindowClosing">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:BoolToVisibilityConverter x:Key="BoolToCollapsed" Invert="True" />
        <conv:NullToVisibilityConverter x:Key="NullToCollapsed" />
        <conv:NullToVisibilityConverter x:Key="NullToVisible" Invert="True" />

        <DropShadowEffect x:Key="ContextMenuDropShadow" po:Freeze="True" BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.55" Color="#000000" />
        <DropShadowEffect x:Key="SearchBarDropShadow" po:Freeze="True" BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.45" Color="Black" />
        <DropShadowEffect x:Key="TileLabelDropShadow" po:Freeze="True" Color="Black" BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.9" />
        <DropShadowEffect x:Key="NoResultsDropShadow" po:Freeze="True" Color="Black" BlurRadius="4" ShadowDepth="1" Opacity="0.85" />
        <DropShadowEffect x:Key="CornerIconDropShadow" po:Freeze="True" Color="Black" BlurRadius="6" ShadowDepth="1.5" Direction="270" Opacity="0.72" />
        <DropShadowEffect x:Key="RenameCardDropShadow" po:Freeze="True" BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.65" Color="Black" />

        <ContextMenu x:Key="DockItemContextMenu"
                     Opened="OnDockItemContextMenuOpened"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem x:Name="ContextRunAsAdmin"
                      Header="Run as Administrator"
                      Visibility="{Binding IsDirectory, Converter={StaticResource BoolToCollapsed}}"
                      Click="OnRunAsAdminClick" />
            <MenuItem x:Name="ContextOpenFileLoc" Header="Open File Location" Click="OnOpenFileLocationClick" />
            <MenuItem x:Name="ContextRename" Header="Rename" Click="OnRenameItemClick" />
            <Separator x:Name="ContextSep" />
            <MenuItem x:Name="ContextSendToRb" Header="Send to Recycle Bin" Click="OnSendToRecycleBinClick" />
            <MenuItem x:Name="ContextOpenSettings" Header="Open Settings" Click="OnOpenSettingsMenuClick" Visibility="Collapsed" />
            <MenuItem x:Name="ContextHideSettings" Header="Hide from Dock" Click="OnHideSettingsFromDockClick" Visibility="Collapsed" />
        </ContextMenu>

        <!-- Dark Frosted ContextMenu -->
        <Style TargetType="ContextMenu">
            <EventSetter Event="Opened" Handler="OnAnyContextMenuOpened" />
            <EventSetter Event="Closed" Handler="OnAnyContextMenuClosed" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="#F2FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Margin="8"
                                MinWidth="182"
                                Background="#EE1A1A1A"
                                BorderBrush="#2EFFFFFF"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="4"
                                Effect="{StaticResource ContextMenuDropShadow}">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Margin" Value="6,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="#1FFFFFFF" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="#F0FFFFFF" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="HighlightBorder"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="HighlightBorder" Property="Background" Value="#1FFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#55FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ScrollBar-free ScrollViewer template -->
        <Style x:Key="DockScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid Background="Transparent">
                            <ScrollContentPresenter CanContentScroll="{TemplateBinding CanContentScroll}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dock Shortcut Tile Button -->
        <Style x:Key="DockTileButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="{Binding TileWidth, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Height" Value="{Binding TileHeight, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TileBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="6,8"
                                RenderOptions.BitmapScalingMode="HighQuality">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Top" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                                    <Condition Binding="{Binding ShowDockBackground, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="TileBorder" Property="Background" Value="#1EFFFFFF" />
                                <Setter TargetName="TileBorder" Property="BorderBrush" Value="#26FFFFFF" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                                    <Condition Binding="{Binding ShowDockBackground, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="TileBorder" Property="Background" Value="#2AFFFFFF" />
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding IsKeyboardSelected}" Value="True">
                                <Setter TargetName="TileBorder" Property="Background" Value="#2264B5F6" />
                                <Setter TargetName="TileBorder" Property="BorderBrush" Value="#9664B5F6" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 24px transparent outer margin allows DropShadowEffect capture without clipping -->
    <Grid x:Name="DockCaptureRoot" Background="Transparent">
        <Border x:Name="DockRootBorder"
                Margin="24"
                Width="520"
                Height="360"
                Background="#01000000"
                BorderBrush="Transparent"
                BorderThickness="0"
                CornerRadius="14"
                Padding="14"
                MouseWheel="OnFallbackDockMouseWheel"
                PreviewMouseLeftButtonDown="OnDockRootMouseLeftButtonDown"
                PreviewMouseLeftButtonUp="OnDockRootMouseLeftButtonUp">

            <Grid Background="Transparent"
                  AllowDrop="True"
                  DragOver="OnItemsAreaDragOver"
                  DragLeave="OnItemsAreaDragLeave"
                  Drop="OnItemsAreaDrop">
                <Grid.ContextMenu>
                    <ContextMenu Opened="OnDockAreaContextMenuOpened">
                        <MenuItem Header="Sort A-Z" Click="OnSortAlphabeticalClick" />
                        <MenuItem x:Name="ToggleMiniDesktopMenuItem"
                                  Header="Mini Desktop Mode"
                                  IsCheckable="True"
                                  Click="OnToggleMiniDesktopMenuClick" />
                        <MenuItem x:Name="SizeSubMenuItem" Header="Grid Size">
                            <MenuItem x:Name="MenuSizeSmall" Header="Small (440×320)" Click="OnSetSizePresetClick" Tag="440,320" IsCheckable="True" />
                            <MenuItem x:Name="MenuSizeDefault" Header="Default (520×360)" Click="OnSetSizePresetClick" Tag="520,360" IsCheckable="True" />
                            <MenuItem x:Name="MenuSizeLarge" Header="Large (680×440)" Click="OnSetSizePresetClick" Tag="680,440" IsCheckable="True" />
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Open Recycle Bin" Click="OnOpenRecycleBinMenuClick" />
                        <MenuItem Header="Empty Recycle Bin" Click="OnEmptyRecycleBinMenuClick" />
                        <Separator />
                        <MenuItem Header="Settings..." Click="OnOpenSettingsMenuClick" />
                    </ContextMenu>
                </Grid.ContextMenu>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Search Bar (revealed via '/' or user-configured SearchShortcut) -->
                <Border x:Name="SearchBarContainer"
                        Grid.Row="0"
                        Visibility="Collapsed"
                        Opacity="0"
                        Height="36"
                        Margin="4,0,4,10"
                        CornerRadius="10"
                        Background="#DC1A1C20"
                        BorderBrush="#36FFFFFF"
                        BorderThickness="1"
                        Effect="{StaticResource SearchBarDropShadow}">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="SearchBarTranslate" Y="-8" />
                    </Border.RenderTransform>
                    <Grid Margin="11,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Path Grid.Column="0"
                              Width="14"
                              Height="14"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Margin="0,0,9,0"
                              Fill="#A8FFFFFF"
                              Data="M15.5,14 L14.71,14 L14.43,13.73 C15.41,12.59 16,11.11 16,9.5 C16,5.91 13.09,3 9.5,3 C5.91,3 3,5.91 3,9.5 C3,13.09 5.91,16 9.5,16 C11.11,16 12.59,15.41 13.73,14.43 L14,14.71 L14,15.5 L19,20.49 L20.49,19 L15.5,14 Z M9.5,14 C7.01,14 5,11.99 5,9.5 C5,7.01 7.01,5 9.5,5 C11.99,5 14,7.01 14,9.5 C14,11.99 11.99,14 9.5,14 Z" />

                        <Grid Grid.Column="1" VerticalAlignment="Center" ClipToBounds="True">
                            <TextBlock x:Name="SearchPlaceholderText"
                                       Text="Search apps..."
                                       Margin="2,0,0,0"
                                       Foreground="#75FFFFFF"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False" />
                            <TextBlock x:Name="SearchAutocompleteText"
                                       Margin="2,0,0,0"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"><Run x:Name="AutocompleteTypedPrefixRun" Foreground="Transparent" /><Run x:Name="AutocompleteSuffixRun" Foreground="#60FFFFFF" /></TextBlock>
                            <TextBox x:Name="SearchTextBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0"
                                     Margin="0"
                                     Foreground="#F5FFFFFF"
                                     CaretBrush="#FF64B5F6"
                                     SelectionBrush="#6664B5F6"
                                     FontFamily="Segoe UI Variable Text, Segoe UI"
                                     FontSize="13"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     TextChanged="OnSearchTextBoxTextChanged"
                                     PreviewKeyDown="OnSearchTextBoxPreviewKeyDown">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <ScrollViewer x:Name="PART_ContentHost"
                                                      Margin="0"
                                                      Padding="0"
                                                      VerticalAlignment="Center" />
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>
                        </Grid>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                            <Button x:Name="ClearSearchButton"
                                    Visibility="Collapsed"
                                    Width="20"
                                    Height="20"
                                    Padding="0"
                                    Content="✕"
                                    FontSize="10.5"
                                    Foreground="#C8FFFFFF"
                                    Background="#1FFFFFFF"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Focusable="False"
                                    Click="OnClearSearchClick">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Border x:Name="EscHintBadge"
                                    Background="#18FFFFFF"
                                    BorderBrush="#24FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="6,2"
                                    Margin="6,0,0,0"
                                    IsHitTestVisible="False">
                                <TextBlock Text="Esc"
                                           FontSize="10.5"
                                           Foreground="#8EFFFFFF" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Background="Transparent">
                    <ScrollViewer x:Name="ItemsScrollViewer"
                                  Background="Transparent"
                                  Focusable="False"
                                  FocusVisualStyle="{x:Null}"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="OnItemsScrollViewerPreviewMouseWheel"
                                  ScrollChanged="OnItemsScrollViewerScrollChanged"
                                  SizeChanged="OnItemsScrollViewerSizeChanged">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer" BasedOn="{StaticResource DockScrollViewerStyle}">
                                <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
                            </Style>
                        </ScrollViewer.Style>
                        <Grid Background="Transparent">
                            <Canvas x:Name="GridOverlayCanvas"
                                    Background="Transparent"
                                    IsHitTestVisible="False"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Visibility="{Binding MiniDesktopMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"
                                    Width="{Binding MiniDesktopGridWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Height="{Binding MiniDesktopGridHeight, RelativeSource={RelativeSource AncestorType=Window}}">
                                <Canvas x:Name="MiniDesktopGridLinesHost"
                                        Background="Transparent"
                                        IsHitTestVisible="False"
                                        Opacity="0" />
                                <Border x:Name="GridSnapHighlightBorder"
                                        Visibility="Collapsed"
                                        CornerRadius="12"
                                        Background="#2464B5F6"
                                        BorderBrush="#9664B5F6"
                                        BorderThickness="1.5" />
                            </Canvas>
                            <ItemsControl x:Name="DockItemsControl" Background="Transparent">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="ItemsPanel">
                                            <Setter.Value>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" Background="Transparent" />
                                                </ItemsPanelTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MiniDesktopMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                <Setter Property="ItemsPanel">
                                                    <Setter.Value>
                                                        <ItemsPanelTemplate>
                                                            <Canvas Background="Transparent"
                                                                    ClipToBounds="False"
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Top"
                                                                    Width="{Binding MiniDesktopGridWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    Height="{Binding MiniDesktopGridHeight, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                        </ItemsPanelTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding CanvasX}" />
                                        <Setter Property="Canvas.Top" Value="{Binding CanvasY}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Background="Transparent"
                                      AllowDrop="True"
                                      DragEnter="OnDockItemDragOver"
                                      DragOver="OnDockItemDragOver"
                                      DragLeave="OnDockItemDragLeave"
                                      Drop="OnDockItemDrop">
                                    <Button Style="{StaticResource DockTileButtonStyle}"
                                            ContextMenu="{StaticResource DockItemContextMenu}"
                                            AllowDrop="True"
                                            Click="OnDockItemClick"
                                            PreviewMouseDown="OnDockItemPreviewMouseDown"
                                            MouseEnter="OnDockItemMouseEnter"
                                            PreviewMouseLeftButtonDown="OnDockItemPreviewMouseLeftButtonDown"
                                            PreviewMouseMove="OnDockItemPreviewMouseMove"
                                            DragEnter="OnDockItemDragOver"
                                            DragOver="OnDockItemDragOver"
                                            DragLeave="OnDockItemDragLeave"
                                            Drop="OnDockItemDrop">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                            <Grid Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  Margin="0,0,0,6"
                                                  RenderTransformOrigin="0.5,0.5">
                                                <Grid.RenderTransform>
                                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                                </Grid.RenderTransform>
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                                <DataTrigger.EnterActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                             To="1.07" Duration="0:0:0.10" />
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                             To="1.07" Duration="0:0:0.10" />
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </DataTrigger.EnterActions>
                                                                <DataTrigger.ExitActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                             To="1.0" Duration="0:0:0.12" />
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                             To="1.0" Duration="0:0:0.12" />
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </DataTrigger.ExitActions>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Image Source="{Binding Icon}"
                                                       Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       Stretch="Uniform"
                                                       StretchDirection="Both"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       SnapsToDevicePixels="True"
                                                       Visibility="{Binding Icon, Converter={StaticResource NullToCollapsed}}" />
                                                <Border CornerRadius="10"
                                                        Background="#1EFFFFFF"
                                                        BorderBrush="#2EFFFFFF"
                                                        BorderThickness="1"
                                                        Visibility="{Binding Icon, Converter={StaticResource NullToVisible}}">
                                                    <TextBlock Text="&#xE7C3;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="22"
                                                               Foreground="#B8FFFFFF"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>

                                            <TextBlock Text="{Binding Name}"
                                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                                       FontSize="12"
                                                       TextOptions.TextFormattingMode="Display"
                                                       Foreground="#F5FFFFFF"
                                                       TextAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="Wrap"
                                                       LineHeight="14.5"
                                                       MaxHeight="29"
                                                       Width="{Binding LabelWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       Visibility="{Binding ShowLabels, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"
                                                       Effect="{StaticResource TileLabelDropShadow}" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Drop Insertion Indicators for Reordering -->
                                    <Border Width="3"
                                            Margin="0,10"
                                            HorizontalAlignment="Left"
                                            CornerRadius="1.5"
                                            Background="#FF64B5F6"
                                            IsHitTestVisible="False"
                                            Visibility="{Binding IsDropBefore, Converter={StaticResource BoolToVisibility}}" />
                                    <Border Width="3"
                                            Margin="0,10"
                                            HorizontalAlignment="Right"
                                            CornerRadius="1.5"
                                            Background="#FF64B5F6"
                                            IsHitTestVisible="False"
                                            Visibility="{Binding IsDropAfter, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                <TextBlock x:Name="NoSearchResultsText"
                           Text="No matching apps"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="13.5"
                           Foreground="#88FFFFFF"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"
                           IsHitTestVisible="False"
                           Effect="{StaticResource NoResultsDropShadow}" />
                </Grid>

                <!-- Optional Corner Recycle Bin Button (off by default; toggleable in Settings) -->
                <Button x:Name="RecycleBinCornerButton"
                        Width="38"
                        Height="34"
                        Margin="0,4,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Cursor="Hand"
                        Focusable="False"
                        Visibility="{Binding ShowCornerRecycleBin, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"
                        Click="OnRecycleBinCornerClick"
                        RenderTransformOrigin="0.5,0.5">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Grid.Row" Value="2" />
                            <Setter Property="Opacity" Value="0.68" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="CornerBg"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="9">
                                            <Border.RenderTransform>
                                                <ScaleTransform x:Name="CornerScale" ScaleX="1" ScaleY="1" />
                                            </Border.RenderTransform>
                                            <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="CornerScale"
                                                                             Storyboard.TargetProperty="ScaleX"
                                                                             To="1.12" Duration="0:0:0.12" />
                                                            <DoubleAnimation Storyboard.TargetName="CornerScale"
                                                                             Storyboard.TargetProperty="ScaleY"
                                                                             To="1.12" Duration="0:0:0.12" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="CornerScale"
                                                                             Storyboard.TargetProperty="ScaleX"
                                                                             To="1.0" Duration="0:0:0.12" />
                                                            <DoubleAnimation Storyboard.TargetName="CornerScale"
                                                                             Storyboard.TargetProperty="ScaleY"
                                                                             To="1.0" Duration="0:0:0.12" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                                                    <Condition Binding="{Binding ShowDockBackground, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="CornerBg" Property="Background" Value="#1EFFFFFF" />
                                                <Setter TargetName="CornerBg" Property="BorderBrush" Value="#26FFFFFF" />
                                            </MultiDataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="1.0" />
                                </Trigger>
                                <DataTrigger Binding="{Binding MiniDesktopMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Grid.Row" Value="1" />
                                    <Setter Property="Width" Value="38" />
                                    <Setter Property="Height" Value="38" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open Recycle Bin" Click="OnOpenRecycleBinMenuClick" />
                            <MenuItem Header="Empty Recycle Bin" Click="OnEmptyRecycleBinMenuClick" />
                        </ContextMenu>
                    </Button.ContextMenu>
                    <Image x:Name="RecycleBinCornerImage"
                           Width="24"
                           Height="24"
                           Stretch="Uniform"
                           StretchDirection="Both"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True"
                           Effect="{StaticResource CornerIconDropShadow}" />
                </Button>

                <!-- Corner Resize Handle (Standard Dock mode only) -->
                <Thumb x:Name="DockResizeThumb"
                       Grid.Row="0"
                       Grid.RowSpan="3"
                       Width="16"
                       Height="16"
                       Margin="0,0,-10,-10"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Cursor="SizeNWSE"
                       DragDelta="OnDockResizeDragDelta"
                       DragCompleted="OnDockResizeDragCompleted">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Grid Background="#01000000">
                                <Path x:Name="GripGlyph"
                                      Data="M5,12 L12,5 M9,12 L12,9"
                                      Stroke="#00FFFFFF"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="GripGlyph" Property="Stroke" Value="#75FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>

                <!-- Inline Dark Frosted Rename Dialog -->
                <Grid x:Name="RenameOverlayHost"
                      Grid.Row="0"
                      Grid.RowSpan="3"
                      Visibility="Collapsed"
                      Background="#70000000"
                      MouseLeftButtonDown="OnRenameScrimMouseDown">
                    <Border Background="#EE1A1C20"
                            BorderBrush="#3CFFFFFF"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16,14"
                            MaxWidth="320"
                            MinWidth="260"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MouseLeftButtonDown="OnRenameCardMouseDown"
                            Effect="{StaticResource RenameCardDropShadow}">
                        <StackPanel>
                            <TextBlock Text="Rename Item"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Foreground="#F5FFFFFF"
                                       Margin="0,0,0,8" />
                            <Border Background="#18FFFFFF"
                                    BorderBrush="#36FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="9,6">
                                <TextBox x:Name="RenameTextBox"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="#F5FFFFFF"
                                         CaretBrush="#FF64B5F6"
                                         SelectionBrush="#6664B5F6"
                                         FontFamily="Segoe UI Variable Text, Segoe UI"
                                         FontSize="13"
                                         PreviewKeyDown="OnRenameTextBoxPreviewKeyDown" />
                            </Border>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                <Button Content="Cancel"
                                        Padding="12,5"
                                        Margin="0,0,6,0"
                                        Foreground="#D0FFFFFF"
                                        Background="#1FFFFFFF"
                                        BorderBrush="#2CFFFFFF"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        Click="OnRenameCancelClick" />
                                <Button Content="Save"
                                        Padding="14,5"
                                        Foreground="#FF111111"
                                        FontWeight="SemiBold"
                                        Background="#FF64B5F6"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="OnRenameSaveClick" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
